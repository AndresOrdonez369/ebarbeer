# Copy to .env and fill in. Without these two, the app runs in demo mode with example data.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Shop slug used in bootstrap_shop(...) and in staff logins (<user>.<slug>@<domain>).
VITE_SHOP_SLUG=bar-beer
# Must match STAFF_EMAIL_DOMAIN in the create-staff Edge Function secrets.
VITE_STAFF_EMAIL_DOMAIN=staff.barbeer.app
